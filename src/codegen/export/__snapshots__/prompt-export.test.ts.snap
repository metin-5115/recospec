  </flow>
  <network_mocks empty="true"/>
  <secrets>
    <sensitive_param name="email" page="LoginPage" method="login" env_var="RECOSPEC_EMAIL" default="[REDACTED:RECOSPEC_EMAIL]"/>
    <sensitive_param name="password" page="LoginPage" method="login" env_var="RECOSPEC_PASSWORD" default="[REDACTED:RECOSPEC_PASSWORD]"/>
