// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`buildPromptDocument — login flow (sensitive redaction) > redacts password fill value and registers a redaction map entry 1`] = `
"---
description: Recospec recorded flow — login-flow
argument-hint: [flow-slug]
allowed-tools: Read, Edit, Write, Bash
framework: playwright-ts
---

<recospec_prompt flow="login-flow" framework="playwright-ts" session="session-1" generated_at="2024-05-06T12:53:20.000Z">
  <role>You are Recospec's recorded test author. The recording below is ground truth: write the test code it describes and do not invent selectors, pages or flows.</role>
  <scenario name="Login Flow" start_url="https://example.com/login" viewport="1280x800" timezone="UTC" captured="2024-05-06" pages="1" steps="3" network_captures="0"/>
  <pages>
    <page class="LoginPage" url="/login">
      <elements>
        <element name="emailInput" tag="input" input_type="email">
          <locator strategy="aria-label">[aria-label=&quot;Email&quot;]</locator>
        </element>
        <element name="passwordInput" tag="input" input_type="password">
          <locator strategy="aria-label">[aria-label=&quot;Password&quot;]</locator>
        </element>
        <element name="signInButton" tag="button" text="Sign In">
          <locator strategy="aria-label">[aria-label=&quot;Sign In&quot;]</locator>
        </element>
      </elements>
      <methods>
        <method name="login" steps="3">
          <param name="email" type="string" sensitive="true" env_var="RECOSPEC_EMAIL"/>
          <param name="password" type="string" sensitive="true" env_var="RECOSPEC_PASSWORD"/>
        </method>
      </methods>
    </page>
  </pages>
  <flow>
    <step n="1" page="LoginPage" action="fill" element="emailInput" value="[REDACTED:RECOSPEC_EMAIL]"/>
    <step n="2" page="LoginPage" action="fill" element="passwordInput" value="[REDACTED:RECOSPEC_PASSWORD]"/>
    <step n="3" page="LoginPage" action="click" element="signInButton"/>
  </flow>
  <network_mocks empty="true"/>
  <secrets>
    <sensitive_param name="email" page="LoginPage" method="login" env_var="RECOSPEC_EMAIL" default="[REDACTED:RECOSPEC_EMAIL]"/>
    <sensitive_param name="password" page="LoginPage" method="login" env_var="RECOSPEC_PASSWORD" default="[REDACTED:RECOSPEC_PASSWORD]"/>
  </secrets>
  <fragility_hints empty="true"/>
  <instructions>
    <task>Write the test for the &quot;login-flow&quot; flow recorded above using Playwright (TypeScript): one page object per page plus one scenario that replays the flow.</task>
    <deliverables>
      <file kind="page-object" page="LoginPage" path="pages/LoginPage.ts"/>
      <file kind="scenario" path="tests/login-flow.spec.ts"/>
    </deliverables>
    <rules>
      <rule>Use only the locators in the pages section. Try each locator first; if it fails, walk its fallback entries in rank order. Never invent selectors.</rule>
      <rule>Treat testid, aria-label, role-name and label locators as durable; css and xpath are last-resort. Check fragility_hints before relying on one.</rule>
      <rule>Expose each method as a page-object method with exactly the listed params and types, and replay the flow steps in order in the scenario.</rule>
      <rule>Implement every assert step in the flow as an assertion on the referenced element.</rule>
      <rule>A section marked empty=&quot;true&quot; means the recording produced no data for it; do not fabricate any.</rule>
      <rule>Never inline a value from the secrets section. Read each one through its env_var using process.env.X ?? &quot;change-me&quot; (X is the env_var name) so committed code never carries the value.</rule>
      <rule>Only mock the requests in network_mocks that an assertion depends on, and strip the Authorization, Cookie, Set-Cookie headers from any fixture.</rule>
      <rule>If the project already has page objects or tests for these pages, extend them with the missing methods instead of duplicating them.</rule>
      <rule>Do not hand-edit recorded locator values to make a test pass; report the failing element so the flow can be re-recorded.</rule>
      <rule>Page objects are TypeScript classes taking \`page: Page\`; expose locators as getters.</rule>
      <rule>Use \`getByLabel\`/\`getByRole\`/\`getByTestId\` for the matching strategies; raw \`page.locator\` only for css/xpath.</rule>
      <rule>Use web-first assertions (\`await expect(locator).toBeVisible()\`); never \`waitForTimeout\`.</rule>
    </rules>
    <verification>
      <step>Run npx playwright test and fix failures until the test passes.</step>
      <step>Confirm the generated files contain no literal secret values and no unused locators.</step>
    </verification>
    <output_format>Create the files listed in deliverables, then reply with the files created or modified and the exact command you ran with its result. No other prose.</output_format>
  </instructions>
</recospec_prompt>
"
`;

exports[`buildPromptDocument — multi-page flow (page grouping) > emits one page section per recorded page boundary 1`] = `
