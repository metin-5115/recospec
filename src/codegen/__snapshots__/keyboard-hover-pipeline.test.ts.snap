[
  "from selenium.webdriver.common.action_chains import ActionChains",
  "SEARCH_INPUT = (By.CSS_SELECTOR, '[data-testid="search-input"]')",
  "def search(self, search: str):",
  "_el = self.wait.until(EC.visibility_of_element_located(self.SEARCH_INPUT))",
  "_el.send_keys(search)",
  "self.driver.switch_to.active_element.send_keys(Keys.ENTER)",
  "def hover_products_menu(self):",
  "ActionChains(self.driver).move_to_element(_el).perform()",
  "def test_search_shop(driver):",
  """"Search shop."""",
  "shop_page.search('shoes')",
  "shop_page.hover_products_menu()",
]
`;
