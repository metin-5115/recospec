{
  "name": "recospec",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode e2e",
    "build:cli": "vite build --config vite.config.cli.ts",
    "package:cli": "node scripts/package-cli.mjs",
    "build:vscode": "vite build --config vite.config.vscode.ts",
    "package:vscode": "pnpm build && pnpm build:vscode && node scripts/package-vscode.mjs",
    "preview": "vite preview",
    "pretest": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --coverage",
    "test:e2e": "playwright test",
    "bench": "vitest run benchmarks/survival.test.ts",
    "bench:calibrate": "vitest run --config vitest.calibrate.config.ts",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "bin": {
    "recospec": "dist/cli/index.js"
  },
  "description": "Chrome extension that records browser interactions and generates production-ready Playwright / Cypress / Selenium test code with Page Object Model output.",
  "keywords": [
    "chrome-extension",
    "test-automation",
    "playwright",
    "codeless",
    "page-object-model"
  ],
  "author": "Metin Tunçbilek <tuncbilek.51metin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/metin-5115/recospec.git"
  },
  "license": "MIT",
  "packageManager": "pnpm@10.32.1",
  "dependencies": {
    "@babel/generator": "^7.29.8",
    "@babel/parser": "^7.29.9",
    "@babel/traverse": "^7.29.10",
    "@babel/types": "^7.29.8",
    "@cucumber/gherkin": "^39.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "commander": "^12.1.0",
    "date-fns": "^4.4.0",
    "dexie": "^4.4.6",
    "dom-accessibility-api": "^0.7.1",
    "jszip": "^3.10.2",
    "lucide-react": "^1.58.0",
    "prompts": "^2.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.7"
  },
  "pnpm": {
    "overrides": {
      "rollup": "^4.62.0",
      "tmp": "^0.2.7",
      "qs": "^6.15.2",
      "brace-expansion@5": "^5.0.6"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@crxjs/vite-plugin": "^2.7.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/chrome": "^0.1.43",
    "@types/node": "^20.19.43",
    "@types/prompts": "^2.4.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/vscode": "^1.140.0",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vscode/vsce": "^3.9.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^16.4.0",
    "marked": "^18.1.1",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vitest": "^4.1.12"
  }
}
